# --- auth ---
# DEV_AUTH on: run with no Firebase project. Any request with
# `Authorization: Bearer <DEV_AUTH_TOKEN>` is the demo user.
DEV_AUTH=true
DEV_AUTH_TOKEN=dev-demo-token
DEV_USER_ID=demo-user
# When DEV_AUTH=false, the bearer must be a valid Firebase ID token:
# FIREBASE_PROJECT_ID=your-firebase-project-id

# --- LLM (Google Gemini, free tier, no card) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# LLM_STUB=true skips every model call and returns placeholders (build/test with no key)
LLM_STUB=false
LLM_TIMEOUT_SECONDS=30

# --- quotas ---
AI_DAILY_QUOTA=50

# --- misc ---
FINSIGHT_DB=finsight.db
REPORTS_DIR=reports
ALLOWED_ORIGINS=http://localhost:8081
SCHEDULER_ENABLED=true
# CHROME_BIN=/path/to/chrome   # only if Chrome/Chromium/Edge is not auto-detected
